[Unit]
Description=Hospital Queue System (ระบบจองคิว)
After=network.target mysql.service mariadb.service

[Service]
WorkingDirectory=/opt/hospital-queue-app
ExecStart=/usr/bin/npm start
Environment=NODE_ENV=production
# ★ PDPA: คีย์เซ็น JWT — production "บังคับ" ต้องตั้ง (ไม่ตั้ง แอปจะปฏิเสธการ start) ★
# สร้างค่าสุ่ม: openssl rand -hex 32 — ห้ามใช้ค่าที่เคยอยู่ใน repo เก่า
Environment=AUTH_SECRET=CHANGE-ME-สร้างด้วย-openssl-rand-hex-32
# ★ PDPA: คีย์เข้ารหัสข้อมูล at rest — ควรตั้งทั้ง json (ทั้งไฟล์) และ mysql (รายฟิลด์ PII ในตาราง) ★
# สร้างด้วย openssl rand -hex 32 — ทำหายคือกู้ข้อมูลไม่ได้ (ดู deploy/IT-RUNBOOK.md)
Environment=DATA_KEY=CHANGE-ME-สร้างด้วย-openssl-rand-hex-32
# ---- ที่เก็บข้อมูล: MySQL (โหมดหลักของการติดตั้งจริง) ----
# ★ แก้ MYSQL_PASSWORD เป็นรหัสที่ตั้งในขั้นตอนสร้างฐานข้อมูล (ดู deploy/IT-RUNBOOK.md ข้อ 3) ★
Environment=STORAGE=mysql
Environment=MYSQL_HOST=127.0.0.1
Environment=MYSQL_PORT=3306
Environment=MYSQL_USER=queueapp
Environment=MYSQL_PASSWORD=CHANGE-ME-ตอนติดตั้ง
Environment=MYSQL_DATABASE=hospital_queue
Environment=PORT=8124
Environment=TZ=Asia/Bangkok
Restart=always
RestartSec=3
User=queueuser
Group=queueuser

[Install]
WantedBy=multi-user.target
