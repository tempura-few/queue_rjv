# ============================================================
# .env.example — ตัวแปรที่ระบบใช้ (คัดลอกเป็น .env แล้วเติมค่าจริง)
# PDPA: ห้าม commit .env ที่มีค่าจริงขึ้น repo เด็ดขาด
# ============================================================

# คีย์เซ็น JWT — production "บังคับ" ต้องตั้ง (ไม่ตั้ง แอปจะปฏิเสธการ start)
# สร้างค่าสุ่ม 256-bit: openssl rand -hex 32
AUTH_SECRET=

# อายุ token (ชั่วโมง) — ค่าเริ่มต้น 12
# AUTH_TTL_HOURS=12

# โหมดเก็บข้อมูล: json (ไฟล์ data/app-data.json) หรือ mysql
STORAGE=json

# คีย์เข้ารหัสข้อมูล at rest (PDPA) — ใช้ "ทั้งสองโหมด":
#   STORAGE=json  → เข้ารหัสทั้งไฟล์ data/app-data.json (AES-256-GCM)
#   STORAGE=mysql → เข้ารหัส "รายฟิลด์" PII ในตาราง (bookings.name/phone/email/note,
#                   users.name, agencies.contact, audit.detail) — คนที่ดึง DB/dump ไปอ่านไม่ออก
# สร้างค่าสุ่ม: openssl rand -hex 32 — ⚠️ จดเก็บไว้ในที่ปลอดภัย ถ้าทำหาย = อ่านข้อมูลทั้งหมดไม่ได้
# ตั้งครั้งแรกกับ DB เดิม: ระบบเข้ารหัสข้อมูล plaintext เดิมให้อัตโนมัติตอน start
# (ชั้นเสริมสำหรับ production: MariaDB data-at-rest encryption — ดู deploy/IT-RUNBOOK.md)
# DATA_KEY=

# ---- เฉพาะ STORAGE=mysql ----
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=queueapp
# MYSQL_PASSWORD=
# MYSQL_DATABASE=hospital_queue

# ---- เฉพาะ STORAGE=json ----
# รหัสผ่านเริ่มต้นของ admin เมื่อฐานข้อมูลว่าง (เปลี่ยนทันทีหลังติดตั้ง)
# ADMIN_PASSWORD=

# จำนวนวันที่เก็บข้อมูลการจองก่อนลบอัตโนมัติ (PDPA — เก็บเท่าที่จำเป็น) ค่าเริ่มต้น 365
# RETENTION_DAYS=365
